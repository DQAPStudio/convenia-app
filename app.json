{
  "expo": {
    "name": "Convenia",
    "slug": "convenia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "convenia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "es.convenia.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es",
          "ca"
        ]
      }
    },
    "android": {
      "package": "es.convenia.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D1630",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D1630"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyUrl": "https://convenia.es/privacidad",
      "termsUrl": "https://convenia.es/terminos",
      "supportUrl": "https://convenia.es/soporte",
      "supabaseUrl": "https://pqdzstciktfavlspvmlg.supabase.co",
      "supabasePublishableKey": "sb_publishable_qp-pg-xL486xqoNYtYJEqA_r9J4gyY0"
    }
  }
}
